@model LoginVm
@{ViewData["Title"]="Đăng nhập";}
<section class="auth-section"><div class="shell"><div class="auth-card">
  <div class="auth-art"><span class="eyebrow light">STAYEASE SANCTUARY · ĐÀ LẠT</span><div><span class="pill copper">Tĩnh tại · Nguyên bản</span><h1>Trở về với<br/><em>khoảng lặng an trú</em><br/>giữa đại ngàn.</h1><p>Hơn cả một chốn nghỉ chân, StayEase gìn giữ những khoảnh khắc thuần khiết và bình yên nhất cho bạn.</p></div><div class="auth-stats"><span>12 Phòng</span><span>Măng Lin</span><span>24/7 Quản gia</span></div></div>
  <div class="auth-form"><div class="brand"><span class="brand-leaf">❧</span><span><strong>StayEase</strong><small>SANCTUARY</small></span></div><div class="tab-nav"><a class="active" asp-action="Login">Đăng nhập</a><a asp-action="Register">Đăng ký</a></div><h2>Chào mừng trở lại</h2><p class="muted">Đăng nhập để quản lý kỳ nghỉ của bạn.</p>
    <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" class="form-stack">
       <div asp-validation-summary="All" class="validation"></div>
       <label>Email <input asp-for="Email" type="email" autocomplete="email" placeholder="name@example.com" /></label>
       <label>Mật khẩu <input asp-for="Password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" /></label>
       <label class="checkbox-line"><input asp-for="RememberMe" /> Ghi nhớ đăng nhập</label>
       <button class="button button-forest button-block" type="submit">Đăng nhập →</button>
       <p class="small-center">Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p>
    </form>
  </div>
</div></div></section>

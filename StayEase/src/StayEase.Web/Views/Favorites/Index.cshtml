@model IReadOnlyList<Favorite>
@{ViewData["Title"]="Yêu thích";}
<div class="shell page-spacer"><div class="page-heading"><span class="eyebrow rust">DÀNH RIÊNG CHO BẠN</span><h1>Danh sách yêu thích ♡</h1></div><div class="rooms-grid">@foreach(var f in Model){<div><article class="room-card"><img class="fav-photo" src="@f.RoomType.ImagePath" alt="@f.RoomType.Name"/><div class="room-card-body"><h3>@f.RoomType.Name</h3><p>@f.RoomType.Description</p><div class="room-card-bottom"><strong>@f.RoomType.PricePerNight.ToString("N0")₫</strong><a class="button button-forest" asp-controller="Rooms" asp-action="Details" asp-route-id="@f.RoomTypeId">Chi tiết</a></div><form asp-action="Toggle" method="post"><input type="hidden" name="roomTypeId" value="@f.RoomTypeId"/><button class="link-danger" type="submit">♡ Bỏ yêu thích</button></form></div></article></div>}</div>@if(Model.Count==0){<div class="empty"><p>Danh sách còn trống. Hãy lưu lại những hạng phòng bạn quan tâm.</p><a asp-controller="Rooms" asp-action="Index" class="button button-forest">Khám phá phòng</a></div>}</div>
